{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@supersolutions/super-plot-core": ["packages/core/src/index.ts"],
      "@supersolutions/super-plot-core/tools": ["packages/core/src/tools.ts"],
      "@supersolutions/super-plot-core/base": ["packages/core/src/base.ts"],
      "@supersolutions/super-plot-core/charts": ["packages/core/src/charts.ts"],
      "@supersolutions/super-plot-core/adapters": ["packages/core/src/adapters.ts"],
      "@supersolutions/super-plot-web": ["packages/bindings/web/src/index.ts"],
      "@supersolutions/super-plot-web/element": ["packages/bindings/web/src/element-entry.ts"],
      "@supersolutions/super-plot-web/base": ["packages/bindings/web/src/base.ts"],
      "@supersolutions/super-plot-react/base": ["packages/bindings/react/src/base.tsx"],
      "@supersolutions/super-plot-react": ["packages/bindings/react/src/index.tsx"]
    }
