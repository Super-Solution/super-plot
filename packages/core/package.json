{
  "name": "@supersolutions/super-plot-core",
  "version": "0.6.0",
  "description": "Renderer-free statistical charts: spec validation, layout to a scene, SVG output, themes and agent tools. No DOM.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/tools.js",
    "./src/index.ts",
    "./src/tools.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./transforms": {
      "types": "./dist/transforms.d.ts",
      "import": "./dist/transforms.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./charts/basic": {
      "types": "./dist/groups/basic.d.ts",
      "import": "./dist/groups/basic.js"
    },
    "./charts/business": {
      "types": "./dist/groups/business.d.ts",
      "import": "./dist/groups/business.js"
    },
    "./charts/stats": {
      "types": "./dist/groups/stats.d.ts",
      "import": "./dist/groups/stats.js"
    },
    "./charts/maps": {
      "types": "./dist/groups/maps.d.ts",
      "import": "./dist/groups/maps.js"
    },
    "./charts/hierarchy": {
      "types": "./dist/groups/hierarchy.d.ts",
      "import": "./dist/groups/hierarchy.js"
    },
    "./charts/3d": {
      "types": "./dist/groups/3d.d.ts",
      "import": "./dist/groups/3d.js"
    },
    "./charts/text": {
      "types": "./dist/groups/text.d.ts",
      "import": "./dist/groups/text.js"
    }
  },
  "typesVersions": {
    "*": {
      "base": [
        "./dist/base.d.ts"
      ],
      "charts": [
        "./dist/charts.d.ts"
      ],
      "tools": [
        "./dist/tools.d.ts"
      ],
      "adapters": [
        "./dist/adapters.d.ts"
      ],
      "transforms": [
        "./dist/transforms.d.ts"
      ],
      "canvas": [
        "./dist/canvas.d.ts"
      ],
      "view": [
        "./dist/view.d.ts"
      ],
      "charts/basic": [
        "./dist/groups/basic.d.ts"
      ],
      "charts/business": [
        "./dist/groups/business.d.ts"
      ],
      "charts/stats": [
        "./dist/groups/stats.d.ts"
      ],
      "charts/maps": [
        "./dist/groups/maps.d.ts"
      ],
      "charts/hierarchy": [
        "./dist/groups/hierarchy.d.ts"
      ],
      "charts/3d": [
        "./dist/groups/3d.d.ts"
      ],
      "charts/text": [
        "./dist/groups/text.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-plot.git",
    "directory": "packages/core"
  },
  "author": "SUPER SOLUTION LABS INC"
}
