{
  "name": "@supersolutions/super-plot-react",
  "version": "0.4.0",
  "description": "<SuperPlot> React component: a thin binding over the web mount.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
