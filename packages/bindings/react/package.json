      "import": "./dist/base.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-plot.git",
    "directory": "packages/bindings/react"
